# Postgres (used by docker-compose & API)
POSTGRES_USER=trailquest
POSTGRES_PASSWORD=trailquest_dev
POSTGRES_DB=trailquest

# API
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://trailquest:trailquest_dev@localhost:5432/trailquest
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Mapbox (mobile + web)
MAPBOX_PUBLIC_TOKEN=pk.YOUR_TOKEN_HERE

# QR signing seed (server-side)
QR_HMAC_SECRET=change-me-qr-secret-min-32-chars-long

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
