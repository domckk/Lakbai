# Local Development Environment
# Copy this to .env and update values as needed

# ===== DATABASE =====
POSTGRES_USER=trailquest
POSTGRES_PASSWORD=trailquest_dev
POSTGRES_DB=trailquest

# ===== API SERVER =====
NODE_ENV=development
API_PORT=4000

# Database URL (used by NestJS API)
DATABASE_URL=postgresql://trailquest:trailquest_dev@localhost:5432/trailquest

# Redis Cache
REDIS_URL=redis://localhost:6379

# JWT Secrets (min 32 characters for security)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min32chars

# JWT Token TTL
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# QR Code Verification
QR_HMAC_SECRET=dev-qr-secret-change-in-production-min32chars

# ===== WEB DASHBOARD =====
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== OPTIONAL: MAPBOX =====
# Get a free token from: https://account.mapbox.com/tokens/
MAPBOX_PUBLIC_TOKEN=pk.YOUR_TOKEN_HERE

# ===== OPTIONAL: ANALYTICS =====
SENTRY_DSN=
